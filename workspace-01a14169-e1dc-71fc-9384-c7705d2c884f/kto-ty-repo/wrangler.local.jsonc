{
  "name": "kto-ty-local",
  "main": "worker.js",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kto-ty-local",
      "migrations_dir": "migrations"
    }
  ]
}
